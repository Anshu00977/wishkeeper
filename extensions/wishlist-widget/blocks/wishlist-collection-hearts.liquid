{% comment %}
  Wishlist Collection Hearts — App Embed Block
  Automatically adds heart icons on every product card across all pages.
{% endcomment %}

{% if block.settings.enabled %}

{{ 'wishlist-collection-hearts.css' | asset_url | stylesheet_tag }}

<!-- Upgrade Modal -->
<div id="wl-upgrade-modal">
  <div id="wl-upgrade-overlay"></div>
  <div id="wl-upgrade-box">
    <button id="wl-upgrade-close">✕</button>
    <div id="wl-upgrade-emoji">💛</div>
    <h2 id="wl-upgrade-title">Wishlist Limit Reached</h2>
    <p id="wl-upgrade-message">
      Your plan can keep only <strong>200</strong> products in the wishlist. Please coordinate with the store owner for any help.
    </p>
  </div>
</div>

<script>
  window.__wlCollectionConfig = {
    shop: {{ shop.permanent_domain | json }},
    proxy: {{ shop.url | json }} + "/apps/wishlist",
    customerId: {{ customer.id | json }} || null,
    activeColor: {{ block.settings.active_color | json }},
    iconSize: {{ block.settings.icon_size }},
    iconStyle: {{ block.settings.icon_style | json }}
  };
</script>

<script src="{{ 'wishlist-collection-hearts.js' | asset_url }}" defer></script>

{% endif %}

{% schema %}
{
  "name": "Wishlist (Collections)",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable wishlist hearts on product cards",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "options": [
        { "value": "heart", "label": "Heart" },
        { "value": "bookmark", "label": "Bookmark" },
        { "value": "star", "label": "Star" }
      ],
      "default": "heart"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active color",
      "default": "#e74c6f"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size (px)",
      "min": 28,
      "max": 48,
      "step": 2,
      "default": 36
    }
  ]
}
{% endschema %} 
